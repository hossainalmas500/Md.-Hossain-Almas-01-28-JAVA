class Student {
    String name;
    int id;

    // Student-er data set korar method
    void setInfo(String n, int i) {
        name = n;
        id = i;
    }

    // Student-er data print korar method
    void display() {
        System.out.println("Name: " + name + ", ID: " + id);
    }
}

public class StudentMain {
    public static void main(String[] args) {
        // 3 ta alada object create kora holo
        Student s1 = new Student();
        Student s2 = new Student();
        Student s3 = new Student();

        // Data assign kora
        s1.setInfo("Rahim", 101);
        s2.setInfo("Karim", 102);
        s3.setInfo("Jabbar", 103);

        // Output show kora
        s1.display();
        s2.display();
        s3.display();
    }
}
